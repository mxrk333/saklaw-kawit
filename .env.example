# SAKLAW configuration. Copy to .env.local and fill in what you need.
# Everything works with no values: the app falls back to a keyless open map
# style (3D buildings + terrain) and external directions links.
#
# NEXT_PUBLIC_* values are bundled into browser code. Only use public,
# domain-restricted keys here. Never put secrets in these variables.

# Optional: MapTiler key (https://cloud.maptiler.com/). Enables a MapTiler
# style and 3D terrain. Restrict the key to your domains in the MapTiler dashboard.
# NEXT_PUBLIC_MAPTILER_KEY=

# Optional: use any MapLibre-compatible style URL instead (overrides the above).
# Pick a style that includes building footprints if you want 3D buildings.
# NEXT_PUBLIC_MAP_STYLE_URL=

# Satellite imagery is the default basemap (toggle with the layers button).
# Without a key it uses Esri World Imagery, which is free to display with
# attribution but subject to Esri's terms of use. For production, use your own
# provider: a MapTiler key (above) switches to MapTiler imagery automatically.
# NEXT_PUBLIC_DEFAULT_BASEMAP=satellite   # or "map"
# NEXT_PUBLIC_SATELLITE=off               # hides the satellite option
# NEXT_PUBLIC_SATELLITE_TILES_URL=        # your own XYZ template, e.g. https://.../{z}/{x}/{y}.jpg
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=      # shown on the map for the URL above

# Terrain (3D relief + hillshade) is on by default using keyless public elevation
# tiles. Kawit is flat, so relief is exaggerated; tune or disable it here.
# NEXT_PUBLIC_TERRAIN=off
# NEXT_PUBLIC_TERRAIN_EXAGGERATION=2
# Optional: your own raster-DEM TileJSON URL (overrides MapTiler / the default).
# NEXT_PUBLIC_TERRAIN_TILES_URL=

# Optional: in-app routing. Each value is the base URL of an OSRM-compatible
# server built for that travel mode (requests go to <base>/route/v1/driving/...).
# Leave empty to offer only "open in Google Maps / Apple Maps" links.
# Public community servers have usage policies, so host your own for production.
# NEXT_PUBLIC_ROUTING_URL_DRIVING=
# NEXT_PUBLIC_ROUTING_URL_WALKING=

# Reports and suggestions are emailed with nodemailer over any SMTP server.
# Server-side only: never prefix these with NEXT_PUBLIC_. Put real values in
# .env.local, never in git. Free options:
#   Brevo   smtp-relay.brevo.com : 587, 300 emails/day free, no card. Create an SMTP key
#           (SMTP & API > SMTP) and verify your sender address. SMTP_USER is the login
#           Brevo shows you; set SMTP_FROM to your verified sender.
#   Gmail   smtp.gmail.com : 465, free. Needs 2-step verification and an App Password
#           (https://myaccount.google.com/apppasswords), never your normal password.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=your-verified-sender@example.com   # optional; defaults to SMTP_USER
# REPORT_TO_EMAIL=where-you-want-reports@example.com
